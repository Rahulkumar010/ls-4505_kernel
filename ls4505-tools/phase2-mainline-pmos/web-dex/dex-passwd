#!/bin/sh
# Manage LS-4505 Web-DeX browser authentication (/etc/dex-webd.auth)
set -e
AUTH_FILE="/etc/dex-webd.auth"
EPOCH_FILE="/run/dex-webd.epoch"

rotate_epoch() {
    od -An -tx1 -N16 /dev/urandom | tr -d ' \n' > "$EPOCH_FILE"
    chmod 0600 "$EPOCH_FILE"
}

case "${1:-}" in
    --disable)
        rm -f "$AUTH_FILE"
        rotate_epoch
        echo "[OK] Web-DeX password protection disabled."
        exit 0
        ;;
    --lock)
        rotate_epoch
        for pid in $(pidof dex-webd); do
            [ "$pid" != "$(cat /run/web-dex.pid 2>/dev/null)" ] && kill "$pid" 2>/dev/null || true
        done
        echo "[OK] All active Web-DeX browser sessions locked."
        exit 0
        ;;
    --help|-h)
        echo "Usage:"
        echo "  dex-passwd                 # Set/change Web-DeX password interactively"
        echo "  dex-passwd <new_password>  # Set/change Web-DeX password non-interactively"
        echo "  dex-passwd --lock          # Immediately lock all open Web-DeX browser tabs"
        echo "  dex-passwd --disable       # Disable Web-DeX password prompt"
        exit 0
        ;;
esac

if [ -n "${1:-}" ]; then
    PW="$1"
else
    printf "New Web-DeX Password: "
    stty -echo 2>/dev/null || true
    IFS= read -r PW
    stty echo 2>/dev/null || true
    printf "\nConfirm Password    : "
    stty -echo 2>/dev/null || true
    IFS= read -r PW2
    stty echo 2>/dev/null || true
    printf "\n"
    if [ "$PW" != "$PW2" ]; then
        echo "[ERR] Passwords do not match!" >&2
        exit 1
    fi
fi

if [ -z "$PW" ]; then
    echo "[ERR] Password cannot be empty." >&2
    exit 1
fi

SALT=$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')
umask 077
/usr/local/bin/dex-webd --hash "$SALT" "$PW" > "$AUTH_FILE"
chmod 0600 "$AUTH_FILE"
rotate_epoch
echo "[OK] Web-DeX password updated (salted SHA-1 stored in $AUTH_FILE)."
