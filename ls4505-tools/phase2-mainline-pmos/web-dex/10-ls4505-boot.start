#!/bin/sh
echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true
for bl in /sys/class/backlight/*/brightness; do
    [ -e "$bl" ] && echo 220 > "$bl" 2>/dev/null || true
done

if ls /tmp/dex-apks/*.apk >/dev/null 2>&1; then
    apk add --no-network --allow-untrusted /tmp/dex-apks/*.apk >/var/log/dex-apk-install.log 2>&1 && rm -rf /tmp/dex-apks
fi

if ip link show usb0 >/dev/null 2>&1; then
    nmcli device set usb0 managed no >/dev/null 2>&1 || true
    ip addr add 172.16.42.1/24 dev usb0 2>/dev/null || true
    ip link set usb0 up 2>/dev/null || true
    killall udhcpd 2>/dev/null || true
    if command -v dnsmasq >/dev/null 2>&1; then
        dnsmasq \
            --pid-file=/run/dnsmasq-dex-usb.pid \
            --interface=usb0 \
            --bind-dynamic \
            --except-interface=lo \
            --dhcp-range=172.16.42.10,172.16.42.50,255.255.255.0,12h \
            --dhcp-option=3 \
            --dhcp-option=6,172.16.42.1 \
            --local=/lan/ --address=/dex.lan/172.16.42.1 2>/dev/null || true
    fi
fi

if [ -b /dev/zram0 ]; then
    swapoff /dev/zram0 2>/dev/null || true
    echo 1 > /sys/block/zram0/reset 2>/dev/null || true
    echo $((256 * 1024 * 1024)) > /sys/block/zram0/disksize 2>/dev/null || true
    mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null || true
fi

modprobe qcom_wcnss_pil 2>/dev/null || true
modprobe wcn36xx 2>/dev/null || true

(
    for i in 1 2 3 4 5 6 7 8; do
        ntpd -n -q -p pool.ntp.org >/dev/null 2>&1 && break
        sleep 5
    done
) &
