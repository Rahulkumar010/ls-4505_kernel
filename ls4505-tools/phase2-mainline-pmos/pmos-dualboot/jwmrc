<?xml version="1.0"?>
<JWM>
    <RootMenu onroot="123">
        <Program label="Terminal" icon="utilities-terminal">xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#11161d" -fg "#e6edf3"</Program>
        <Program label="Touch Keyboard" icon="input-keyboard">matchbox-keyboard</Program>
        <Program label="Wi-Fi Manager (nmtui)" icon="network-wireless">xterm -fa "DejaVu Sans Mono" -fs 11 -e "sudo nmtui"</Program>
        <Separator/>
        <Program label="USB OTG Host ON (5V + MT7601U)" icon="network-wired">xterm -fa "DejaVu Sans Mono" -fs 10 -hold -e "sudo /usr/local/bin/otg-mode host"</Program>
        <Program label="USB Gadget RNDIS ON (PC SSH)" icon="computer">xterm -fa "DejaVu Sans Mono" -fs 10 -e "sudo /usr/local/bin/otg-mode gadget"</Program>
        <Separator/>
        <Program label="Web Browser (Dillo)" icon="web-browser">dillo</Program>
        <Program label="File Manager (Thunar)" icon="system-file-manager">thunar /home/user</Program>
        <Program label="System Monitor (htop)" icon="utilities-system-monitor">xterm -fa "DejaVu Sans Mono" -fs 10 -e "htop"</Program>
        <Separator/>
        <Program label="Boot Android 6.0.1" icon="system-reboot">/usr/local/bin/reboot-to-android</Program>
        <Program label="Reboot Linux 6.12.1" icon="view-refresh">/usr/local/bin/reboot-to-linux</Program>
        <Program label="Boot lk2nd Fastboot" icon="applications-system">/usr/local/bin/reboot-to-fastboot</Program>
    </RootMenu>

    <!-- Large 42px Touch Taskbar at Top -->
    <Tray x="0" y="0" height="42" autohide="off" halign="fixed" valign="top">
        <TrayButton label=" Apps ">root:1</TrayButton>
        <TrayButton label=" Kbd ">exec:matchbox-keyboard</TrayButton>
        <TrayButton label=" Term ">exec:xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#11161d" -fg "#e6edf3"</TrayButton>
        <TrayButton label=" OTG ">exec:xterm -fa "DejaVu Sans Mono" -fs 10 -hold -e "sudo /usr/local/bin/otg-mode host"</TrayButton>
        <TaskList maxwidth="90"/>
        <Dock/>
        <Clock format="%H:%M"><Button mask="123">exec:xterm -fa "DejaVu Sans Mono" -fs 11 -e "sudo nmtui"</Button></Clock>
    </Tray>

    <!-- Bottom Quick-Switch Touch Bar -->
    <Tray x="0" y="-1" height="38" autohide="off" halign="fixed" valign="bottom">
        <TrayButton label=" Wi-Fi ">exec:xterm -fa "DejaVu Sans Mono" -fs 11 -e "sudo nmtui"</TrayButton>
        <TrayButton label=" Web ">exec:dillo</TrayButton>
        <TrayButton label=" Files ">exec:thunar /home/user</TrayButton>
        <TrayButton label=" Android ">exec:/usr/local/bin/reboot-to-android</TrayButton>
    </Tray>

    <WindowStyle>
        <Font>DejaVu Sans-11:bold</Font>
        <Width>4</Width>
        <Height>34</Height>
        <Corner>4</Corner>
        <Foreground>#ffffff</Foreground>
        <Background>#1f6feb</Background>
        <Outline>#30363d</Outline>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#238636</Background>
            <Outline>#3fb950</Outline>
        </Active>
    </WindowStyle>

    <TrayStyle>
        <Font>DejaVu Sans-11:bold</Font>
        <Background>#161b22</Background>
        <Foreground>#e6edf3</Foreground>
        <Outline>#30363d</Outline>
        <Active>
            <Background>#238636</Background>
            <Foreground>#ffffff</Foreground>
        </Active>
    </TrayStyle>

    <MenuStyle>
        <Font>DejaVu Sans-12</Font>
        <Foreground>#e6edf3</Foreground>
        <Background>#161b22</Background>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#1f6feb</Background>
        </Active>
    </MenuStyle>

    <Desktops width="1" height="1">
        <Background type="solid">#0d1117</Background>
    </Desktops>

    <DoubleClickSpeed>400</DoubleClickSpeed>
    <DoubleClickDelta>12</DoubleClickDelta>
    <FocusModel>click</FocusModel>

    <!-- Hardware / Capacitive Button Bindings! -->
    <Key keycode="166">close</Key>
    <Key key="XF86Back">close</Key>
    <Key key="XF86HomePage">showdesktop</Key>
    <Key key="Menu">root:1</Key>
</JWM>
