<?xml version="1.0"?>
<JWM>
    <RootMenu onroot="123">
        <Program label="Terminal">xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#11161d" -fg "#e6edf3"</Program>
        <Program label="Touch Keyboard">matchbox-keyboard</Program>
        <Program label="Wi-Fi Manager (nmtui)">xterm -fa "DejaVu Sans Mono" -fs 11 -e nmtui</Program>
        <Separator/>
        <Program label="USB OTG Host ON (5V + MT7601U)">xterm -fa "DejaVu Sans Mono" -fs 10 -hold -e /usr/local/bin/otg-mode host</Program>
        <Program label="USB Gadget RNDIS ON (PC SSH)">xterm -fa "DejaVu Sans Mono" -fs 10 -hold -e /usr/local/bin/otg-mode gadget</Program>
        <Program label="USB &amp; Dual-WiFi Status">xterm -fa "DejaVu Sans Mono" -fs 10 -hold -e /usr/local/bin/otg-mode status</Program>
        <Separator/>
        <Program label="Web Browser (Dillo)">dillo</Program>
        <Program label="File Manager (Thunar)">thunar /root</Program>
        <Program label="System Monitor (htop)">xterm -fa "DejaVu Sans Mono" -fs 10 -e htop</Program>
        <Separator/>
        <Program label="Boot Android 6.0.1">/usr/local/bin/reboot-to-android</Program>
        <Program label="Reboot Linux 6.12.1">/usr/local/bin/reboot-to-linux</Program>
        <Program label="Boot lk2nd Fastboot">/usr/local/bin/reboot-to-fastboot</Program>
    </RootMenu>

    <Tray x="0" y="0" height="42" autohide="off" halign="fixed" valign="top">
        <TrayButton label=" Apps ">root:1</TrayButton>
        <TrayButton label=" Kbd ">exec:matchbox-keyboard</TrayButton>
        <TrayButton label=" Term ">exec:xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#11161d" -fg "#e6edf3"</TrayButton>
        <TrayButton label=" OTG ON ">exec:xterm -fa "DejaVu Sans Mono" -fs 10 -hold -e /usr/local/bin/otg-mode host</TrayButton>
        <TaskList maxwidth="80"/>
        <Dock/>
        <Clock format="%H:%M"><Button mask="123">exec:xterm -fa "DejaVu Sans Mono" -fs 11 -e nmtui</Button></Clock>
    </Tray>

    <Tray x="0" y="-1" height="38" autohide="off" halign="fixed" valign="bottom">
        <TrayButton label=" Wi-Fi ">exec:xterm -fa "DejaVu Sans Mono" -fs 11 -e nmtui</TrayButton>
        <TrayButton label=" Web ">exec:dillo</TrayButton>
        <TrayButton label=" Files ">exec:thunar /root</TrayButton>
        <TrayButton label=" Android ">exec:/usr/local/bin/reboot-to-android</TrayButton>
    </Tray>

    <WindowStyle>
        <Font>DejaVu Sans-11:bold</Font>
        <Width>4</Width>
        <Height>34</Height>
        <Corner>4</Corner>
        <Foreground>#ffffff</Foreground>
        <Background>#1f6feb</Background>
        <Outline>#30363d</Outline>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#238636</Background>
            <Outline>#3fb950</Outline>
        </Active>
    </WindowStyle>

    <TrayStyle>
        <Font>DejaVu Sans-11:bold</Font>
        <Background>#161b22</Background>
        <Foreground>#e6edf3</Foreground>
        <Outline>#30363d</Outline>
        <Active>
            <Background>#238636</Background>
            <Foreground>#ffffff</Foreground>
        </Active>
    </TrayStyle>

    <MenuStyle>
        <Font>DejaVu Sans-12</Font>
        <Foreground>#e6edf3</Foreground>
        <Background>#161b22</Background>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#1f6feb</Background>
        </Active>
    </MenuStyle>

    <Desktops width="1" height="1">
        <Background type="solid">#0d1117</Background>
    </Desktops>

    <DoubleClickSpeed>400</DoubleClickSpeed>
    <DoubleClickDelta>12</DoubleClickDelta>
    <FocusModel>click</FocusModel>

    <Key key="XF86Back">close</Key>
    <Key key="XF86HomePage">showdesktop</Key>
    <Key key="Menu">root:1</Key>
</JWM>
