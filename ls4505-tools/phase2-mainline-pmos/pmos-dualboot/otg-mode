#!/bin/sh
mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
SMB_BUS=""
for d in /sys/bus/i2c/devices/i2c-*; do
    case "$(readlink -f "$d")" in
        *78b8000.i2c*) SMB_BUS="${d##*i2c-}" ;;
    esac
done
ROLE_FILE=$(ls /sys/class/usb_role/*/role /sys/kernel/debug/ci_hdrc.*/role /sys/kernel/debug/usb/ci_hdrc.*/role 2>/dev/null | head -n 1)

case "${1:-status}" in
    host|on)
        [ -e /sys/kernel/config/usb_gadget/g1/UDC ] && echo "" > /sys/kernel/config/usb_gadget/g1/UDC 2>/dev/null || true
        if [ -n "$SMB_BUS" ]; then
            # 1. Unlock SMB1360 volatile register writes (CMD_I2C_REG 0x40 |= ALLOW_VOLATILE_BIT 0x40)
            C40=$(i2cget -f -y "$SMB_BUS" 0x14 0x40 2>/dev/null || echo 0x00)
            i2cset -f -y "$SMB_BUS" 0x14 0x40 $(printf "0x%02x" $(( C40 | 0x40 )))
            # 2. Set OTG battery current limit to 1500mA (CFG_BATT_CHG_REG 0x00 |= 0x18)
            C00=$(i2cget -f -y "$SMB_BUS" 0x14 0x00 2>/dev/null || echo 0xbb)
            i2cset -f -y "$SMB_BUS" 0x14 0x00 $(printf "0x%02x" $(( C00 | 0x18 )))
            # 3. Enable 5V OTG Boost converter (CMD_CHG_REG 0x42 |= CMD_OTG_EN_BIT 0x01)
            C42=$(i2cget -f -y "$SMB_BUS" 0x14 0x42 2>/dev/null || echo 0x02)
            NEW42=$(printf "0x%02x" $(( C42 | 0x01 )))
            i2cset -f -y "$SMB_BUS" 0x14 0x42 "$NEW42"
            echo "[OK] SMB1360 5V 1.5A OTG Boost ENABLED on i2c-$SMB_BUS (0x40=$(i2cget -f -y "$SMB_BUS" 0x14 0x40), 0x42=$(i2cget -f -y "$SMB_BUS" 0x14 0x42))"
        fi
        [ -n "$ROLE_FILE" ] && echo host > "$ROLE_FILE"
        modprobe mt7601u 2>/dev/null || true
        sleep 3
        echo "[OK] USB OTG Host mode active! Connected USB devices:"
        lsusb 2>/dev/null || true
        nmcli device status 2>/dev/null || ip -o link
        ;;
    gadget|peripheral|device|off)
        if [ -n "$SMB_BUS" ]; then
            C40=$(i2cget -f -y "$SMB_BUS" 0x14 0x40 2>/dev/null || echo 0x40)
            i2cset -f -y "$SMB_BUS" 0x14 0x40 $(printf "0x%02x" $(( C40 | 0x40 )))
            C42=$(i2cget -f -y "$SMB_BUS" 0x14 0x42 2>/dev/null || echo 0x02)
            NEW42=$(printf "0x%02x" $(( C42 & ~0x01 )))
            i2cset -f -y "$SMB_BUS" 0x14 0x42 "$NEW42"
            echo "[OK] SMB1360 5V OTG Boost DISABLED on i2c-$SMB_BUS (0x42=$(i2cget -f -y "$SMB_BUS" 0x14 0x42))"
        fi
        if [ -n "$ROLE_FILE" ]; then
            echo device > "$ROLE_FILE" 2>/dev/null || echo gadget > "$ROLE_FILE" 2>/dev/null || true
        fi
        UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        if [ -n "$UDC" ] && [ -d /sys/kernel/config/usb_gadget/g1 ]; then
            echo "$UDC" > /sys/kernel/config/usb_gadget/g1/UDC 2>/dev/null || true
            ip addr add 172.16.42.1/24 dev usb0 2>/dev/null || true
            ip link set usb0 up 2>/dev/null || true
        fi
        echo "[OK] USB Gadget (RNDIS 172.16.42.1) mode active!"
        ;;
    *)
        echo "ChipIdea USB Role: $(cat "$ROLE_FILE" 2>/dev/null || echo N/A)"
        echo "SMB1360 I2C Bus  : ${SMB_BUS:-N/A} (0x40=$( [ -n "$SMB_BUS" ] && i2cget -f -y "$SMB_BUS" 0x14 0x40 2>/dev/null || echo N/A ), 0x42=$( [ -n "$SMB_BUS" ] && i2cget -f -y "$SMB_BUS" 0x14 0x42 2>/dev/null || echo N/A ))"
        lsusb 2>/dev/null || true
        nmcli device status 2>/dev/null || ip -o link
        ;;
esac
